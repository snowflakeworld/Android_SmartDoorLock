<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/sdialog_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:background="@color/white"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        tools:ignore="UselessParent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/sdialog_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="18dp"
                android:contentDescription="@string/sdialog_icon"
                android:scaleType="centerInside"
                android:visibility="gone" />

            <TextView
                android:id="@+id/sdialog_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha=".9"
                android:textColor="#000"
                android:textSize="20dp"
                android:textStyle="bold"
                tools:text="Title of SDialog" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/edit_parent_password_now"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/change_password_hint_now"
                android:textColorHint="@color/edit_help_color"
                app:boxStrokeColor="@color/mtrl_outlined_stroke_color">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_password_now"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLength="30"
                    android:singleLine="true"
                    android:textColor="@color/edit_text_color"
                    android:textSize="@dimen/font_size_large" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/edit_parent_password_new"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:hint="@string/change_password_hint_new"
                android:textColorHint="@color/edit_help_color"
                app:boxStrokeColor="@color/mtrl_outlined_stroke_color">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_password_new"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLength="30"
                    android:singleLine="true"
                    android:textColor="@color/edit_text_color"
                    android:textSize="@dimen/font_size_large" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/edit_parent_password_new_confirm"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:hint="@string/change_password_hint_new_confirm"
                android:textColorHint="@color/edit_help_color"
                app:boxStrokeColor="@color/mtrl_outlined_stroke_color">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_password_new_confirm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLength="30"
                    android:singleLine="true"
                    android:textColor="@color/edit_text_color"
                    android:textSize="@dimen/font_size_large" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/sdialog_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:visibility="visible">

            <TextView
                android:id="@+id/sdialog_neutral"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?selectableItemBackground"
                android:clickable="true"
                android:paddingHorizontal="18dp"
                android:paddingVertical="8dp"
                android:textColor="@color/grey55"
                android:textSize="16dp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Neutral" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/sdialog_negative"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?selectableItemBackground"
                android:clickable="true"
                android:paddingHorizontal="18dp"
                android:paddingVertical="8dp"
                android:textColor="@color/grey55"
                android:textSize="16dp"
                android:textStyle="bold"
                android:visibility="visible"
                tools:text="@string/button_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sdialog_positive"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/spacing_small"
                android:background="?selectableItemBackground"
                android:clickable="true"
                android:paddingHorizontal="18dp"
                android:paddingVertical="8dp"
                android:textColor="@color/white"
                android:textSize="16dp"
                android:textStyle="bold"
                android:visibility="visible"
                tools:text="@string/button_ok" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>